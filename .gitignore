# Hapo Ndani — the public client apps.
#
# This file is deliberately blunt. A build artifact, a certificate or a
# provisioning profile that lands in a public repo cannot be un-published, so
# whole categories are refused by extension rather than by path.

# ── Secrets, keys, certificates, provisioning ──────────────────────────────
# Never commit any of these, under any name, at any depth.
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.crt
*.der
*.keystore
*.jks
*.mobileprovision
*.provisionprofile
*.certSigningRequest
*.gpg
*.asc
id_rsa*
id_ed25519*
.env
.env.*
!.env.example
secrets.*
credentials.*
service-account*.json
gha-creds-*.json

# Contributor-supplied local config (see README — these hold your own values)
desktop-local/Signing.local.xcconfig
desktop-windows/config.json
android-companion/keystore.properties
local.properties

# ── Model weights (large, and licensed by their publishers, not by us) ─────
*.gguf
*.litertlm
*.litertlm.part*
*.safetensors
*.bin
*.onnx
*.mlmodel
*.mlmodelc
*.mlpackage
android-companion/model-pack-part*/src/main/assets/
output/
models/

# ── Apple / Xcode build output ─────────────────────────────────────────────
# NdaniDesktop.xcodeproj is GENERATED by XcodeGen; never commit it.
*.xcodeproj/
*.xcworkspace/
.build/
.swiftpm/
DerivedData/
build/
*.xcarchive
*.dSYM
*.dSYM.zip
*.ipa
*.app
*.app.zip
*.pkg
*.dmg
*.xcuserstate
xcuserdata/
Packages/*/.build/

# ── Android / Gradle build output ──────────────────────────────────────────
.gradle/
.kotlin/
**/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.aar
*.ap_
*.dex
output-metadata.json
*.iml

# ── Node / Electron build output ───────────────────────────────────────────
node_modules/
dist/
out/
release/
npm-debug.log*
yarn-error.log*
*.exe
*.msi
*.AppImage
*.deb
*.rpm
*.snap
*.nsis.7z
*.blockmap

# ── Editors and OS noise ───────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.venv/

# Local-only operator context - never publish
AGENTS.md
STATUS.md
